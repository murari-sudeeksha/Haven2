# HAVEN Real Estate AI Platform Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If left blank or MongoDB is not running locally, HAVEN automatically initializes
# a high-performance in-memory MongoDB instance for instantaneous turnkey operation.
MONGODB_URI=mongodb://127.0.0.1:27017/haven_db

# JWT Secret for Authentication
JWT_SECRET=haven_jwt_ultra_secure_secret_key_2026_production_grade_9876543210
JWT_EXPIRES_IN=7d

# Optional LLM API for Conversational Assistant (Gemini / OpenAI / Groq)
# HAVEN includes an intelligent, deterministic local NLP engine that works out of the box with zero API keys.
# To enable cloud LLM enhancement, provide your API key below:
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Configuration
CLIENT_URL=http://localhost:5173
