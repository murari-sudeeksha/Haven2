# HAVEN Root Environment Configuration Example

# Backend
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/haven_db
JWT_SECRET=haven_jwt_ultra_secure_secret_key_2026_production_grade_9876543210
JWT_EXPIRES_IN=7d

# Optional Cloud LLM API Keys (Gemini / OpenAI)
# HAVEN includes a deterministic NLP engine that works with zero API keys.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:5000/api
